<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/overshop_background"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="GESTIÓN DE PRODUCTOS"
        android:textColor="@color/overshop_orange"
        android:textSize="22sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/tvSellerProductsCount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Productos registrados: 0"
        android:textColor="@color/overshop_white"
        android:textSize="14sp"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnAddSellerProduct"
        android:layout_width="match_parent"
        android:layout_height="@dimen/button_height"
        android:background="@drawable/bg_button_primary"
        android:text="AGREGAR PRODUCTO"
        android:textColor="@color/overshop_white"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/tvSellerProductsEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="No hay productos registrados."
        android:textColor="@color/overshop_text_secondary"
        android:gravity="center"
        android:visibility="gone"
        android:padding="24dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerSellerProducts"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="12dp" />

</LinearLayout>
