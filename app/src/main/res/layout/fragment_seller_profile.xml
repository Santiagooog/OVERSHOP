<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/overshop_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/tvSellerProfileNameLabel"
            android:labelFor="@id/etSellerProfileName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="MI PERFIL"
            android:textColor="@color/overshop_orange"
            android:textSize="24sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="24dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="INFORMACIÓN DE LA CUENTA"
            android:textColor="@color/overshop_white"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nombre completo"
            android:textColor="@color/overshop_text_secondary" />

        <EditText
            android:id="@+id/etSellerProfileName"
            android:autofillHints="personName"
            android:importantForAutofill="no"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:enabled="false"
            android:inputType="textPersonName"
            android:textColor="@color/overshop_white"
            android:textColorHint="@color/overshop_text_secondary" />

        <TextView
            android:id="@+id/tvSellerProfileEmailLabel"
            android:labelFor="@id/etSellerProfileEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Correo electrónico"
            android:textColor="@color/overshop_text_secondary" />

        <EditText
            android:id="@+id/etSellerProfileEmail"
            android:autofillHints="emailAddress"
            android:importantForAutofill="no"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:enabled="false"
            android:inputType="textEmailAddress"
            android:textColor="@color/overshop_white" />

        <TextView
            android:id="@+id/tvSellerProfilePhoneLabel"
            android:labelFor="@id/etSellerProfilePhone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Teléfono"
            android:textColor="@color/overshop_text_secondary" />

        <EditText
            android:id="@+id/etSellerProfilePhone"
            android:autofillHints="phone"
            android:importantForAutofill="no"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:enabled="false"
            android:inputType="phone"
            android:textColor="@color/overshop_white" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tipo de cuenta"
            android:textColor="@color/overshop_text_secondary" />

        <TextView
            android:id="@+id/tvSellerProfileRole"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="VENDEDOR"
            android:textColor="@color/overshop_orange"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="32dp" />

        <Button
            android:id="@+id/btnSellerLogout"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:background="@drawable/bg_button_primary"
            android:text="CERRAR SESIÓN"
            android:textColor="@color/overshop_white"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>
