<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/overshop_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="MI PERFIL"
            android:textColor="@color/overshop_white"
            android:textSize="25sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Administra tu información personal"
            android:textColor="@color/overshop_text_secondary"
            android:textSize="14sp" />

        <!-- Información personal -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="INFORMACIÓN PERSONAL"
            android:textColor="@color/overshop_orange"
            android:textSize="16sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etProfileName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_input"
            android:enabled="false"
            android:hint="Nombre completo"
            android:inputType="textPersonName"
            android:padding="14dp"
            android:textColor="@color/overshop_white"
            android:textColorHint="@color/overshop_text_secondary" />

        <EditText
            android:id="@+id/etProfileEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_input"
            android:enabled="false"
            android:hint="Correo electrónico"
            android:inputType="textEmailAddress"
            android:padding="14dp"
            android:textColor="@color/overshop_white"
            android:textColorHint="@color/overshop_text_secondary" />

        <EditText
            android:id="@+id/etProfilePhone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_input"
            android:enabled="false"
            android:hint="Teléfono"
            android:inputType="phone"
            android:padding="14dp"
            android:textColor="@color/overshop_white"
            android:textColorHint="@color/overshop_text_secondary" />

        <EditText
            android:id="@+id/etProfileAddress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_input"
            android:enabled="false"
            android:hint="Dirección de entrega"
            android:inputType="textPostalAddress"
            android:padding="14dp"
            android:textColor="@color/overshop_white"
            android:textColorHint="@color/overshop_text_secondary" />

        <EditText
            android:id="@+id/etProfileCity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_input"
            android:enabled="false"
            android:hint="Ciudad"
            android:inputType="textCapWords"
            android:padding="14dp"
            android:textColor="@color/overshop_white"
            android:textColorHint="@color/overshop_text_secondary" />

        <Button
            android:id="@+id/btnEditProfile"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="16dp"
            android:backgroundTint="@color/overshop_orange"
            android:text="EDITAR INFORMACIÓN"
            android:textColor="@color/overshop_black"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnSaveProfile"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="8dp"
            android:backgroundTint="@color/overshop_orange"
            android:text="GUARDAR CAMBIOS"
            android:textColor="@color/overshop_black"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- Historial de pedidos -->

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="28dp"
            android:background="@color/overshop_border" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="MIS PEDIDOS"
            android:textColor="@color/overshop_orange"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvProfileOrderCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="0 pedidos registrados"
            android:textColor="@color/overshop_text_secondary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvProfileOrdersEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:padding="20dp"
            android:text="Todavía no tienes pedidos.\n¡Explora nuestro catálogo!"
            android:textColor="@color/overshop_text_secondary"
            android:textSize="14sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/layoutProfileOrders"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical" />

        <!-- Cerrar sesión -->

        <Button
            android:id="@+id/btnLogout"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="24dp"
            android:backgroundTint="@color/overshop_black"
            android:text="CERRAR SESIÓN"
            android:textColor="@color/overshop_orange"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>
