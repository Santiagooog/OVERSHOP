<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/overshop_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_medium">

        <!-- Encabezado -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="OVERSHOP"
                    android:textColor="@color/overshop_white"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.12"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TU ESTILO, TUS REGLAS"
                    android:textColor="@color/overshop_orange"
                    android:textSize="10sp"
                    android:letterSpacing="0.10"/>

            </LinearLayout>

            <ImageButton
                android:id="@+id/btnNotifications"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_input"
                android:src="@android:drawable/ic_popup_reminder"
            app:tint="@color/overshop_orange"
                android:contentDescription="Notificaciones"/>

        </LinearLayout>

        <!-- Bienvenida -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="BIENVENIDO A OVERSHOP"
            android:textColor="@color/overshop_white"
            android:textSize="22sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Descubre las últimas tendencias streetwear."
            android:textColor="@color/overshop_text_secondary"
            android:textSize="@dimen/text_normal"/>

        <!-- Buscador -->
        <EditText
            android:id="@+id/etSearchProducts"
            android:layout_width="match_parent"
            android:layout_height="@dimen/input_height"
            android:layout_marginTop="22dp"
            android:background="@drawable/bg_input"
            android:hint="Buscar productos..."
            android:drawableStart="@android:drawable/ic_menu_search"
            android:drawablePadding="10dp"
            android:paddingHorizontal="@dimen/spacing_medium"
            android:textColor="@color/overshop_white"
            android:textColorHint="@color/overshop_text_secondary"
            android:singleLine="true"/>

        <!-- Banner -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="170dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_button_primary"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:padding="@dimen/spacing_large">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NUEVA COLECCIÓN"
                android:textColor="@color/overshop_white"
                android:textSize="23sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="STREETWEAR 2026"
                android:textColor="@color/overshop_white"
                android:textSize="@dimen/text_normal"/>

            <TextView
                android:id="@+id/tvExploreCollection"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="EXPLORA AHORA →"
                android:textColor="@color/overshop_white"
                android:textStyle="bold"/>

        </LinearLayout>

        <!-- Categorías -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="CATEGORÍAS"
            android:textColor="@color/overshop_white"
            android:textSize="@dimen/text_large"
            android:textStyle="bold"/>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_medium"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnHoodies"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:text="Hoodies"
                    android:textColor="@color/overshop_white"
                    android:background="@drawable/bg_button_primary"
                    android:backgroundTint="@null"/>

                <Button
                    android:id="@+id/btnTshirts"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginStart="8dp"
                    android:text="Camisetas"
                    android:textColor="@color/overshop_white"
                    android:background="@drawable/bg_input"
                    android:backgroundTint="@null"/>

                <Button
                    android:id="@+id/btnPants"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginStart="8dp"
                    android:text="Pantalones"
                    android:textColor="@color/overshop_white"
                    android:background="@drawable/bg_input"
                    android:backgroundTint="@null"/>

                <Button
                    android:id="@+id/btnAccessories"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginStart="8dp"
                    android:text="Accesorios"
                    android:textColor="@color/overshop_white"
                    android:background="@drawable/bg_input"
                    android:backgroundTint="@null"/>

            </LinearLayout>

        </HorizontalScrollView>

        <!-- Productos destacados -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="PRODUCTOS DESTACADOS"
            android:textColor="@color/overshop_white"
            android:textSize="@dimen/text_large"
            android:textStyle="bold"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerFeaturedProducts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_medium"
            android:clipToPadding="false"
            android:nestedScrollingEnabled="false"
            android:paddingBottom="12dp" />

        <TextView
            android:id="@+id/tvFeaturedEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_medium"
            android:background="@drawable/bg_input"
            android:gravity="center"
            android:padding="20dp"
            android:text="Aún no hay productos para mostrar."
            android:textColor="@color/overshop_text_secondary"
            android:visibility="gone" />

    </LinearLayout>

</ScrollView>
