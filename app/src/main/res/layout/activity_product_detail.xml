<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/overshop_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Volver -->
        <TextView
            android:id="@+id/tvBackDetail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="← VOLVER AL CATÁLOGO"
            android:textColor="@color/overshop_orange"
            android:textSize="14sp"
            android:textStyle="bold"
            android:padding="8dp" />

        <!-- Imagen del producto -->
        <ImageView
            android:id="@+id/imgDetailProduct"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:layout_marginTop="16dp"
            android:background="@color/overshop_black"
            android:scaleType="centerCrop"
            android:contentDescription="Imagen del producto" />

        <!-- Categoría -->
        <TextView
            android:id="@+id/tvDetailCategory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:textColor="@color/overshop_orange"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- Nombre -->
        <TextView
            android:id="@+id/tvDetailName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/overshop_white"
            android:textSize="26sp"
            android:textStyle="bold" />

        <!-- Precio -->
        <TextView
            android:id="@+id/tvDetailPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="@color/overshop_orange"
            android:textSize="23sp"
            android:textStyle="bold" />

        <!-- Descripción -->
        <TextView
            android:id="@+id/tvDetailDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textColor="@color/overshop_text_secondary"
            android:textSize="15sp"
            android:lineSpacingExtra="5dp" />

        <!-- Tallas -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Selecciona tu talla"
            android:textColor="@color/overshop_white"
            android:textSize="16sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/rgSizes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rbSizeS"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:buttonTint="@color/overshop_orange"
                android:text="S"
                android:textColor="@color/overshop_white" />

            <RadioButton
                android:id="@+id/rbSizeM"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:buttonTint="@color/overshop_orange"
                android:text="M"
                android:textColor="@color/overshop_white" />

            <RadioButton
                android:id="@+id/rbSizeL"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:buttonTint="@color/overshop_orange"
                android:text="L"
                android:textColor="@color/overshop_white" />

            <RadioButton
                android:id="@+id/rbSizeXL"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="@color/overshop_orange"
                android:text="XL"
                android:textColor="@color/overshop_white" />

        </RadioGroup>

        <!-- Cantidad -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="Cantidad"
            android:textColor="@color/overshop_white"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnDecrease"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:minWidth="0dp"
                android:text="-"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/tvQuantity"
                android:layout_width="50dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="1"
                android:textColor="@color/overshop_white"
                android:textSize="18sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnIncrease"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:minWidth="0dp"
                android:text="+"
                android:textSize="20sp" />

        </LinearLayout>

        <!-- Agregar al carrito -->
        <Button
            android:id="@+id/btnAddToCart"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="24dp"
            android:backgroundTint="@color/overshop_orange"
            android:text="AGREGAR AL CARRITO"
            android:textColor="@color/overshop_black"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>
