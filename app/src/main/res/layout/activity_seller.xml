<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/overshop_background"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/sellerFragmentContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/sellerBottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/overshop_black"
        app:itemIconTint="@color/overshop_orange"
        app:itemTextColor="@color/overshop_white"
        app:menu="@menu/menu_seller" />

</LinearLayout>
