<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/overshop_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/tvBackCheckout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:text="← VOLVER AL CARRITO"
            android:textColor="@color/overshop_orange"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="FINALIZAR COMPRA"
            android:textColor="@color/overshop_white"
            android:textSize="25sp"
            android:textStyle="bold" />

        <!-- Información de contacto -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Información de contacto"
            android:textColor="@color/overshop_orange"
            android:textSize="17sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etCheckoutName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_input"
            android:hint="Nombre completo"
            android:inputType="textPersonName"
            android:padding="14dp"
            android:textColor="@color/overshop_white"
            android:textColorHint="@color/overshop_text_secondary" />

        <EditText
            android:id="@+id/etCheckoutEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_input"
            android:hint="Correo electrónico"
            android:inputType="textEmailAddress"
            android:padding="14dp"
            android:textColor="@color/overshop_white"
            android:textColorHint="@color/overshop_text_secondary" />

        <EditText
            android:id="@+id/etCheckoutPhone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_input"
            android:hint="Número de teléfono"
            android:inputType="phone"
            android:padding="14dp"
            android:textColor="@color/overshop_white"
            android:textColorHint="@color/overshop_text_secondary" />

        <!-- Dirección -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="Dirección de entrega"
            android:textColor="@color/overshop_orange"
            android:textSize="17sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etCheckoutAddress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_input"
            android:hint="Dirección completa"
            android:inputType="textPostalAddress"
            android:padding="14dp"
            android:textColor="@color/overshop_white"
            android:textColorHint="@color/overshop_text_secondary" />

        <EditText
            android:id="@+id/etCheckoutCity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_input"
            android:hint="Ciudad"
            android:inputType="textCapWords"
            android:padding="14dp"
            android:textColor="@color/overshop_white"
            android:textColorHint="@color/overshop_text_secondary" />

        <!-- Método de pago -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="Método de pago"
            android:textColor="@color/overshop_orange"
            android:textSize="17sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/rgPaymentMethods"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/rbPaymentCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:buttonTint="@color/overshop_orange"
                android:text="Tarjeta de crédito / débito"
                android:textColor="@color/overshop_white" />

            <RadioButton
                android:id="@+id/rbPaymentTransfer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:buttonTint="@color/overshop_orange"
                android:text="Transferencia bancaria"
                android:textColor="@color/overshop_white" />

            <RadioButton
                android:id="@+id/rbPaymentCash"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:buttonTint="@color/overshop_orange"
                android:text="Pago contra entrega"
                android:textColor="@color/overshop_white" />

        </RadioGroup>

        <!-- Resumen -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="Resumen de compra"
            android:textColor="@color/overshop_orange"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvCheckoutItems"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="@color/overshop_text_secondary"
            android:textSize="14sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:background="@color/overshop_border" />

        <TextView
            android:id="@+id/tvCheckoutTotal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="end"
            android:text="TOTAL: $0"
            android:textColor="@color/overshop_orange"
            android:textSize="21sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Los métodos de pago son demostrativos. No se realizarán cobros reales."
            android:textColor="@color/overshop_text_secondary"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnConfirmOrder"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="24dp"
            android:backgroundTint="@color/overshop_orange"
            android:text="CONFIRMAR PEDIDO"
            android:textColor="@color/overshop_black"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>
