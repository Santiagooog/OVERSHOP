<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    android:background="@color/overshop_black"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <ImageView
        android:id="@+id/imgCartProduct"
        android:layout_width="95dp"
        android:layout_height="120dp"
        android:contentDescription="Producto del carrito"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvCartName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/overshop_white"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvCartSize"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:textColor="@color/overshop_text_secondary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvCartUnitPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:textColor="@color/overshop_text_secondary"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnCartDecrease"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:minWidth="0dp"
                android:text="-"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/tvCartQuantity"
                android:layout_width="35dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="1"
                android:textColor="@color/overshop_white"
                android:textSize="15sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnCartIncrease"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:minWidth="0dp"
                android:text="+"
                android:textSize="18sp" />

        </LinearLayout>

        <TextView
            android:id="@+id/tvCartSubtotal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/overshop_orange"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnCartRemove"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginTop="4dp"
            android:minWidth="0dp"
            android:text="ELIMINAR"
            android:textColor="@color/overshop_orange"
            android:textSize="11sp" />

    </LinearLayout>

</LinearLayout>
