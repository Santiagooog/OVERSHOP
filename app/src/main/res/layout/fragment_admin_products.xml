<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/overshop_background"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Gestión de productos"
        android:textColor="@color/overshop_white"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="16dp"
        android:text="Administra el catálogo de OVERSHOP"
        android:textColor="@color/overshop_text_secondary"
        android:textSize="13sp" />

    <Button
        android:id="@+id/btnAddSellerProduct"
        android:layout_width="match_parent"
        android:layout_height="@dimen/button_height"
        android:background="@drawable/bg_button_primary"
        android:text="Agregar producto"
        android:textAllCaps="false"
        android:textColor="@color/overshop_white" />

    <TextView
        android:id="@+id/tvSellerProductsCount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:layout_marginBottom="10dp"
        android:text="Productos registrados: 0"
        android:textColor="@color/overshop_text_secondary"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/tvSellerProductsEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="24dp"
        android:text="No hay productos registrados"
        android:textColor="@color/overshop_text_secondary"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerSellerProducts"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="12dp" />

</LinearLayout>
