<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/overshop_black"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="@dimen/spacing_large">

        <!-- Marca -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="70dp"
            android:text="@string/brand_name"
            android:textColor="@color/overshop_white"
            android:textSize="32sp"
            android:textStyle="bold"
            android:letterSpacing="0.15"/>

        <View
            android:layout_width="90dp"
            android:layout_height="3dp"
            android:layout_marginTop="@dimen/spacing_small"
            android:background="@color/overshop_orange"/>

        <!-- Título -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="55dp"
            android:text="RECUPERAR CONTRASEÑA"
            android:textColor="@color/overshop_orange"
            android:textSize="22sp"
            android:textStyle="bold"
            android:gravity="center"/>

        <!-- Icono -->
        <ImageView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_marginTop="35dp"
            android:src="@android:drawable/ic_lock_lock"
            app:tint="@color/overshop_orange"
            android:contentDescription="Recuperación de contraseña"/>

        <!-- Descripción -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_large"
            android:text="¿Olvidaste tu contraseña?"
            android:textColor="@color/overshop_white"
            android:textSize="@dimen/text_large"
            android:textStyle="bold"
            android:gravity="center"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_medium"
            android:text="Ingresa el correo electrónico asociado a tu cuenta para iniciar el proceso de recuperación."
            android:textColor="@color/overshop_text_secondary"
            android:textSize="@dimen/text_normal"
            android:gravity="center"
            android:lineSpacingExtra="5dp"/>

        <!-- Correo -->
        <EditText
            android:id="@+id/etRecoveryEmail"
            android:layout_width="match_parent"
            android:layout_height="@dimen/input_height"
            android:layout_marginTop="35dp"
            android:background="@drawable/bg_input"
            android:hint="@string/email_hint"
            android:inputType="textEmailAddress"
            android:autofillHints="emailAddress"
            android:paddingHorizontal="@dimen/spacing_medium"
            android:textColor="@color/overshop_white"
            android:textColorHint="@color/overshop_text_secondary"
            android:singleLine="true"/>

        <!-- Enviar -->
        <Button
            android:id="@+id/btnRecovery"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="@dimen/spacing_large"
            android:background="@drawable/bg_button_primary"
            android:backgroundTint="@null"
            android:text="ENVIAR SOLICITUD"
            android:textColor="@color/overshop_white"
            android:textStyle="bold"/>

        <!-- Regresar -->
        <TextView
            android:id="@+id/tvBackRecovery"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="35dp"
            android:text="Volver al inicio de sesión"
            android:textColor="@color/overshop_orange"
            android:textSize="@dimen/text_normal"
            android:clickable="true"
            android:focusable="true"/>

    </LinearLayout>

</ScrollView>
