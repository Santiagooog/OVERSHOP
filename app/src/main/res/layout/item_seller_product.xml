<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="12dp"
    android:layout_marginBottom="12dp"
    android:background="@color/overshop_black">

    <ImageView
        android:id="@+id/imgSellerProduct"
        android:layout_width="85dp"
        android:layout_height="105dp"
        android:scaleType="centerCrop"
        android:contentDescription="Imagen del producto" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="12dp">

        <TextView
            android:id="@+id/tvSellerProductName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/overshop_white"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSellerProductCategory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/overshop_text_secondary"
            android:textSize="13sp"
            android:layout_marginTop="4dp" />

        <TextView
            android:id="@+id/tvSellerProductPrice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/overshop_orange"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginTop="6dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <Button
                android:id="@+id/btnEditSellerProduct"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="EDITAR"
                android:textSize="10sp" />

            <Button
                android:id="@+id/btnDeleteSellerProduct"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="ELIMINAR"
                android:textSize="10sp" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
