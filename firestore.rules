rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function role() {
      return signedIn()
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : null;
    }
    function isAdmin() { return role() == 'Administrador'; }
    function isSellerOrAdmin() { return role() in ['Vendedor', 'Administrador']; }

    match /users/{uid} {
      allow create: if (signedIn() && request.auth.uid == uid
        && request.resource.data.role in ['Comprador', 'Vendedor']
        && request.resource.data.uid == uid)
        || (isAdmin()
          && request.resource.data.uid == uid
          && request.resource.data.role in ['Comprador', 'Vendedor', 'Administrador']
          && request.resource.data.fullName is string
          && request.resource.data.email is string
          && request.resource.data.phone is string);
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow update: if isAdmin() || (signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fullName', 'phone', 'address', 'city']));
      allow delete: if isAdmin() && request.auth.uid != uid;
    }

    match /products/{productId} {
      allow read: if signedIn();
      allow create, delete: if isSellerOrAdmin();
      allow update: if isSellerOrAdmin() || (signedIn() && role() == 'Comprador'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['salesCount'])
        && request.resource.data.salesCount is int
        && request.resource.data.salesCount > resource.data.get('salesCount', 0)
        && request.resource.data.salesCount <= resource.data.get('salesCount', 0) + 100);
    }

    match /carts/{uid}/items/{itemId} {
      allow read, write: if signedIn() && request.auth.uid == uid
        && role() == 'Comprador';
    }

    match /orders/{orderId} {
      allow create: if signedIn() && role() == 'Comprador'
        && request.resource.data.buyerUid == request.auth.uid
        && request.resource.data.paymentStatus == 'simulated'
        && request.resource.data.paymentProvider == 'Simulación'
        && request.resource.data.status == 'Confirmado'
        && request.resource.data.total is int
        && request.resource.data.total > 0;
      allow read: if signedIn() && (resource.data.buyerUid == request.auth.uid || isSellerOrAdmin());
      allow update: if isSellerOrAdmin()
        && resource.data.paymentStatus == 'simulated'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['Confirmado', 'Preparando', 'Enviado', 'Entregado', 'Cancelado'];
      allow delete: if isAdmin();
    }
  }
}
